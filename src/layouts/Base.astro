---
import '@/styles/globals.css';

interface Props {
  title: string;
  /** 検索結果に出る説明文。どのページにも書く */
  description: string;
}

const { title, description } = Astro.props;
// SEO（ADR-0017）。canonical・og:url・og:image は astro.config の site（https://koyomi.tkc310.com）で絶対 URL にする
const siteName = 'タイ仏教行事カレンダー';
const home = new URL('/', Astro.site ?? Astro.url).href;
const canonical = new URL(Astro.url.pathname, home).href;
const ogImage = new URL('/og.png', home).href;
// JSON-LD（ADR-0017・0020）。どのページにも運営者（Organization・ロゴ）と WebSite を出す。
// トップ以外（行事の詳細・タンブン）は記事（Article）とパンくずを足す。
// 行事は会場があって予約できる催しではないので、Google の Event の条件に合わず、Event は出さない
const pageName = title.split(' | ')[0]!;
const organization = { '@id': `${home}#organization` };
const graph: Record<string, unknown>[] = [
  {
    '@type': 'Organization',
    ...organization,
    name: siteName,
    url: home,
    logo: {
      '@type': 'ImageObject',
      url: new URL('/icons/icon-512.png', home).href,
      width: 512,
      height: 512,
    },
  },
  {
    '@type': 'WebSite',
    '@id': `${home}#website`,
    name: siteName,
    url: home,
    inLanguage: 'ja',
    publisher: organization,
  },
];
if (canonical !== home) {
  graph.push(
    {
      '@type': 'Article',
      headline: pageName,
      description,
      mainEntityOfPage: canonical,
      image: [ogImage],
      inLanguage: 'ja',
      // 内容はビルドのたびに暦から作り直すので、更新日はビルドした日にする
      dateModified: new Date().toISOString().slice(0, 10),
      author: organization,
      publisher: organization,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: siteName, item: home },
        { '@type': 'ListItem', position: 2, name: pageName, item: canonical },
      ],
    },
  );
}
const ld = { '@context': 'https://schema.org', '@graph': graph };
// </script> で途切れないよう < をエスケープする
const jsonLd = JSON.stringify(ld).replaceAll('<', '\\u003c');
// 配色は白に固定する。OS のダークモードには追従しない（data-theme="light"）
const nav = [
  { href: '/#calendar', label: 'カレンダー' },
  { href: '/#events', label: '行事の一覧' },
  { href: '/#ics', label: '取り込む' },
  { href: '/#app', label: 'アプリ' },
];
// ブラウザの上の帯（スマホ）とホーム画面から開いたときの色。ヘッダーの面（白）に合わせる
const themeColor = '#ffffff';
---

<html lang="ja" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="タイ仏教行事" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="タイ仏教行事カレンダー。タイの仏教行事の日付と意味を、日本語で。"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body class="flex min-h-dvh flex-col bg-canvas text-fg">
    <header class="border-b border-border-subtle bg-surface">
      <!-- スマホではロゴの下に案内を並べ、md 以上で 1 行にする -->
      <div class="mx-auto flex max-w-5xl flex-col gap-gap-xs px-inset-lg pt-inset-md pb-inset-xs md:flex-row md:items-center md:justify-between md:gap-gap-md md:px-inset-xl md:py-inset-md">
        <a
          href="/"
          class="focus-ring flex items-center gap-gap-sm self-start rounded-md text-label-md text-fg no-underline md:self-center"
        >
          <!-- ロゴ: 法輪とサイト名（public/logo.svg。make brand で作る）。文字はアウトライン化してある -->
          <img src="/logo.svg" alt={siteName} width="478" height="80" class="h-10 w-auto md:h-12" />
        </a>
        <nav aria-label="ページ内の案内">
          <ul class="-mx-inset-sm my-0 flex list-none flex-wrap p-0 md:gap-gap-xs">
            {nav.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  class="focus-ring inline-flex min-h-control-md items-center rounded-xs px-inset-sm text-body-sm text-fg-subtle no-underline hover:text-fg hover:underline hover:underline-offset-[0.3em]"
                >
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <div class="flex-1">
      <slot />
    </div>
    <footer class="mt-stack-lg border-t border-border-subtle bg-subtle">
      <div class="mx-auto flex max-w-5xl flex-col gap-gap-xs px-inset-lg py-inset-xl md:px-inset-xl">
        <p class="m-0 text-body-sm text-fg-subtle">
          日付はタイの太陰暦から計算し、タイ政府の公式発表と照らし合わせています。出典は各行事のページにあります。
        </p>
      </div>
    </footer>
    <script>
      // オフラインでも開けるよう、Service Worker（public/sw.js）を登録する。読み込みが終わってから登録し、表示を遅らせない。
      // 開発サーバーでは登録しない（保存した古いページで変更が見えなくなるため。ADR-0013）
      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
