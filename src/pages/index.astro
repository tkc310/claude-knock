---
import { getEntry } from 'astro:content';
import EventCalendar from '@/components/event/EventCalendar.astro';
import EventCard from '@/components/event/EventCard.astro';
import SectionHeading from '@/components/site/SectionHeading.astro';
import Base from '@/layouts/Base.astro';
import { Icon } from '@/components/ui/icon';
import { occurrences } from '@/core';
import { displayRange } from '@/data/display-range';
import { events } from '@/data/events';

const now = new Date();
const today = now.toLocaleDateString('sv-SE');
const range = displayRange(now);
const years = `${range.from.slice(0, 4)}〜${range.to.slice(0, 4)} 年`;
const list = occurrences(events, range);
const entries = await Promise.all(
  events.map(async (event) => {
    const entry = await getEntry('events', event.id);
    if (!entry) throw new Error(`src/content/events/${event.id}.md がありません`);
    return entry;
  }),
);

const about = [
  {
    icon: 'moon',
    text: 'タイの仏教行事の多くは、月の満ち欠けにもとづく「タイの太陰暦」で日が決まるため、毎年日付が変わります。このサイトでは、その日付を暦から計算し、タイ政府の公式発表と照らし合わせて載せています。',
  },
  {
    icon: 'wheel',
    text: '載せているのは、仏典（経・律）やブッダの生涯に根拠がある行事です。例外として、タイで広く行われるロイクラトンとソンクラーンを「民間行事」として載せています。',
  },
  {
    icon: 'lotus',
    text: 'ワンプラやブーチャーの日には、在家の人々も布施・戒・瞑想などで功徳を積みます（タンブン）。その行いと経典の根拠を、別のページにまとめています。',
    link: { href: '/tambun/', label: 'タンブン（功徳を積む行い）について' },
  },
] as const;

// ホーム画面に追加する（PWA。ADR-0013）。オフラインで見られるのは public/sw.js が保存するため
const installs = [
  {
    app: 'iPhone・iPad（Safari）',
    steps: [
      'Safari でこのページを開き、共有ボタン（四角から上向きの矢印）を押す',
      'メニューを下へ送り、「ホーム画面に追加」を選ぶ',
      '名前を確かめて「追加」を押す',
    ],
  },
  {
    app: 'Android（Chrome）',
    steps: [
      'Chrome でこのページを開き、右上のメニュー（︙）を押す',
      '「ホーム画面に追加」または「アプリをインストール」を選ぶ',
      '「インストール」（または「追加」）を押す',
    ],
  },
  {
    app: 'パソコン（Chrome・Edge）',
    steps: [
      'アドレスバーの右端にあるインストールのアイコン（画面と下向きの矢印）を押す',
      'アイコンが無いときは、Chrome はメニューの「キャスト、保存、共有」、Edge はメニューの「アプリ」から選ぶ',
      '「インストール」を押すと、別のウィンドウのアプリとして開く',
    ],
  },
];

const imports = [
  {
    app: 'Google カレンダー（パソコン）',
    steps: [
      '右上の歯車から「設定」を開く',
      '左のメニューで「インポート / エクスポート」を選ぶ',
      '「パソコンからファイルを選択」で calendar.ics を選び、追加先のカレンダーを選んで「インポート」を押す',
    ],
  },
  {
    app: 'iPhone・Mac のカレンダー',
    steps: [
      'iPhone は Safari で上のボタンを押し、「すべてを追加」を選ぶ',
      'Mac はダウンロードした calendar.ics をダブルクリックする',
      '追加先のカレンダーを選んで「OK」を押す',
    ],
  },
  {
    app: 'Outlook（Web）',
    steps: [
      '左のメニューで「カレンダー」を開き、「カレンダーを追加」を選ぶ',
      '「ファイルからアップロード」で calendar.ics と追加先のカレンダーを選ぶ',
      '「インポート」を押す',
    ],
  },
];
---

<Base
  title="タイ仏教行事カレンダー"
  description="タイの仏教行事（ワンプラ、マーカ・ブーチャー、ウィサーカ・ブーチャー、カオパンサーなど）の日付と意味を、日本語でまとめたカレンダーです。タイの太陰暦から計算し、公式発表と照らし合わせています。カレンダーアプリへの取り込み（ICS）にも対応。"
>
  <main>
    <section
      aria-labelledby="site-title"
      class="relative overflow-hidden border-b border-border-subtle bg-gold-subtle"
    >
      <!-- 飾り: 右上に月の暈（かさ）のような同心円 -->
      <svg
        viewBox="0 0 400 400"
        aria-hidden="true"
        focusable="false"
        class="pointer-events-none absolute -top-40 -right-40 size-[28rem] text-gold-soft md:-top-24 md:-right-24"
      >
        <circle cx="200" cy="200" r="70" fill="currentColor" opacity="0.35"></circle>
        <circle
          cx="200"
          cy="200"
          r="110"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        ></circle>
        <circle
          cx="200"
          cy="200"
          r="150"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
          stroke-dasharray="2 6"
        ></circle>
        <circle
          cx="200"
          cy="200"
          r="190"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
        ></circle>
      </svg>
      <div class="relative mx-auto grid max-w-5xl gap-stack-md px-inset-lg py-stack-md md:px-inset-xl md:py-stack-lg">
        <div class="flex flex-col gap-inset-lg">
          <!-- 飾り: 月の満ち欠け（新月・上弦・満月・下弦）。行事が月で決まることを表す -->
          <svg
            viewBox="0 0 88 16"
            aria-hidden="true"
            focusable="false"
            class="h-4 w-[5.5rem] text-gold"
          >
            <path
              d="M1.5 8a6.5 6.5 0 1 0 13 0a6.5 6.5 0 1 0 -13 0ZM25.5 8a6.5 6.5 0 1 0 13 0a6.5 6.5 0 1 0 -13 0ZM73.5 8a6.5 6.5 0 1 0 13 0a6.5 6.5 0 1 0 -13 0Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            ></path>
            <path
              d="M32 1.5 A6.5 6.5 0 0 1 32 14.5 ZM48.75 8a7.25 7.25 0 1 0 14.5 0a7.25 7.25 0 1 0 -14.5 0ZM80 1.5 A6.5 6.5 0 0 0 80 14.5 Z"
              fill="currentColor"
            ></path>
          </svg>
          <!-- サイト名はヘッダーにあるので、導入文をページの見出し（h1）にして大きく出す -->
          <h1
            id="site-title"
            class="m-0 text-heading-md text-balance [font-feature-settings:'palt'] [word-break:auto-phrase] md:text-heading-xl"
          >
            タイの仏教行事の<span class="text-fg-saffron">日付と意味</span>
            を、日本語でまとめたカレンダーです。
          </h1>
          <div class="flex flex-wrap items-center gap-gap-sm">
            <a
              href="#calendar"
              class="focus-ring inline-flex min-h-control-md items-center gap-gap-xs rounded-md bg-key px-inset-lg text-label-md text-fg-on-key no-underline hover:bg-key-hover"
            >
              カレンダーを見る
              <Icon name="chevron-down" size="sm" />
            </a>
            <a
              href="#ics"
              class="focus-ring inline-flex min-h-control-md items-center gap-gap-xs rounded-md border border-border bg-surface px-inset-lg text-label-md text-fg no-underline hover:bg-muted"
            >
              カレンダーアプリに取り込む
            </a>
          </div>
        </div>
      </div>
    </section>

    <div class="mx-auto flex max-w-5xl flex-col gap-stack-lg px-inset-lg pt-stack-md md:px-inset-xl md:pt-stack-lg">
      <section aria-labelledby="about" class="flex flex-col gap-stack-md">
        <SectionHeading id="about" eyebrow="About" title="このサイトについて" />
        <ul class="m-0 grid list-none gap-gap-md p-0 md:grid-cols-2">
          {about.map((item) => (
            <li
              class:list={[
                'flex items-start gap-gap-md rounded-sm bg-subtle p-inset-xl',
                'link' in item && 'md:col-span-2',
              ]}
            >
              <span
                aria-hidden="true"
                class="inline-flex size-10 shrink-0 items-center justify-center rounded-full bg-saffron-muted text-fg-saffron"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="size-icon-md"
                >
                  {item.icon === 'moon' ? (
                    <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" />
                  ) : item.icon === 'lotus' ? (
                    <path d="M12 19c-4 0-7-2.5-8-6 2.5 0 5 1 6.5 3M12 19c4 0 7-2.5 8-6-2.5 0-5 1-6.5 3M12 19c-2-2-3-4.5-3-7.5 1.2.6 2.3 1.6 3 3 .7-1.4 1.8-2.4 3-3 0 3-1 5.5-3 7.5ZM12 14.5c-.8-2.6-.5-5.4 0-8 .5 2.6.8 5.4 0 8Z" />
                  ) : (
                    <>
                      <circle cx="12" cy="12" r="8" />
                      <circle cx="12" cy="12" r="2" />
                      <path d="M12 4v6M12 14v6M4 12h6M14 12h6M6.3 6.3l4.3 4.3M13.4 13.4l4.3 4.3M17.7 6.3l-4.3 4.3M10.6 13.4l-4.3 4.3" />
                    </>
                  )}
                </svg>
              </span>
              <div class="flex flex-col gap-gap-sm">
                <p class="m-0 text-body-sm">{item.text}</p>
                {'link' in item && (
                  <a
                    href={item.link.href}
                    class="focus-ring inline-flex items-center gap-gap-xs self-start rounded-xs text-body-sm font-bold text-fg-link underline underline-offset-[0.2em] hover:text-fg-link-hover"
                  >
                    {item.link.label}
                    <Icon name="chevron-right" size="sm" />
                  </a>
                )}
              </div>
            </li>
          ))}
        </ul>
        <p class="m-0 text-body-sm">
          {years}の予定は、
          <a
            href="#ics"
            class="focus-ring rounded-xs text-fg-link underline underline-offset-[0.2em] hover:text-fg-link-hover"
          >
            カレンダーアプリに取り込めます
          </a>
          。
        </p>
      </section>

      <section aria-labelledby="calendar" class="flex flex-col gap-stack-md">
        <SectionHeading id="calendar" eyebrow="Calendar" title="行事カレンダー">
          <p class="m-0 text-body-sm text-fg-subtle">
            月ごとに行事を見られます。行事名を押すと詳しい説明のページへ移ります。
          </p>
        </SectionHeading>
        <EventCalendar range={range} list={list} today={today} />
      </section>

      <section aria-labelledby="events" class="flex flex-col gap-stack-md">
        <SectionHeading id="events" eyebrow="Events" title="行事の一覧">
          <p class="m-0 text-body-sm text-fg-subtle">
            由来と行うことを、カードにまとめています。押すと詳しい説明のページへ移ります。
          </p>
        </SectionHeading>
        <ul class="m-0 grid list-none gap-gap-md p-0 md:grid-cols-[repeat(auto-fill,minmax(15rem,1fr))]">
          {events.map((event, i) => (
            <EventCard event={event} entry={entries[i]!} />
          ))}
        </ul>
      </section>

      <section
        aria-labelledby="ics"
        class="flex flex-col overflow-hidden rounded-sm border border-border-subtle"
      >
        <div class="flex flex-col gap-stack-md bg-gold-subtle p-inset-xl md:flex-row md:items-end md:justify-between md:gap-gutter">
          <SectionHeading id="ics" eyebrow="Import" title="カレンダーアプリに取り込む">
            <p class="m-0 max-w-prose text-body-sm">
              {years}の行事をまとめた ICS ファイル（calendar.ics）をダウンロードできます。Google
              カレンダーや iPhone のカレンダーなどに取り込むと、行事が終日の予定として入ります。
            </p>
          </SectionHeading>
          <a
            href="/calendar.ics"
            download="thai-buddhist-calendar.ics"
            class="focus-ring inline-flex min-h-control-lg shrink-0 items-center justify-center gap-gap-sm self-start rounded-md bg-key px-inset-xl text-label-md text-fg-on-key no-underline shadow-1 hover:bg-key-hover md:self-auto"
          >
            <Icon name="download" />
            calendar.ics をダウンロード
          </a>
        </div>
        <div class="grid gap-px bg-border-subtle md:grid-cols-3">
          {imports.map(({ app, steps }) => (
            <div class="flex flex-col gap-gap-md bg-surface p-inset-xl">
              <h3 class="m-0 text-heading-xxs">{app}</h3>
              <ol class="m-0 flex list-none flex-col gap-gap-md p-0">
                {steps.map((step, n) => (
                  <li class="flex gap-gap-sm">
                    <span
                      aria-hidden="true"
                      class="inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-saffron-muted text-label-sm text-fg-saffron tabular-nums"
                    >
                      {n + 1}
                    </span>
                    <span class="text-body-sm">{step}</span>
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>
        <p class="m-0 flex gap-gap-sm border-t border-border-subtle bg-subtle px-inset-xl py-inset-lg text-body-sm text-fg-subtle">
          <Icon name="info" size="sm" className="mt-1 text-icon-subtle" />
          <span>
            取り込んだ予定は自動では更新されません。年が変わったら、新しいファイルを取り込み直してください。予定をまとめて消せるよう、取り込む前に専用のカレンダーを作っておくと便利です。
          </span>
        </p>
      </section>

      <section
        aria-labelledby="app"
        class="flex flex-col overflow-hidden rounded-sm border border-border-subtle"
      >
        <div class="flex flex-col gap-stack-md bg-gold-subtle p-inset-xl">
          <SectionHeading id="app" eyebrow="App" title="ホーム画面に追加する（アプリとして使う）">
            <p class="m-0 max-w-prose text-body-sm">
              ホーム画面やパソコンのアプリ一覧に法輪のアイコンを置き、アプリのように開けます。一度開くと、行事のページと
              calendar.ics が端末に保存され、オフライン（電波の届かない場所）でも見られます。
            </p>
          </SectionHeading>
        </div>
        <div class="grid gap-px bg-border-subtle md:grid-cols-3">
          {installs.map(({ app, steps }) => (
            <div class="flex flex-col gap-gap-md bg-surface p-inset-xl">
              <h3 class="m-0 text-heading-xxs">{app}</h3>
              <ol class="m-0 flex list-none flex-col gap-gap-md p-0">
                {steps.map((step, n) => (
                  <li class="flex gap-gap-sm">
                    <span
                      aria-hidden="true"
                      class="inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-saffron-muted text-label-sm text-fg-saffron tabular-nums"
                    >
                      {n + 1}
                    </span>
                    <span class="text-body-sm">{step}</span>
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>
      </section>
    </div>
  </main>
</Base>
