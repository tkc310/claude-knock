---
// トップページの行事の一覧のカード。カード全体が詳細ページへのリンク。
// スマホファースト（ADR-0013）: 由来と行うこと（data-popover）は、既定ではカードの中に出す。
// カーソルのある md 以上の画面（hoverable:）でだけカードの外へ浮かせ、ホバー・フォーカスで表示年の日付と一緒に出す。
// 行事名はすぐ隣のカードにあるので、ポップアップには繰り返さない
// 浮かせたときの左右の置き場所は src/pages/index.astro の script が決める（data-card・data-popover）
import type { CollectionEntry } from 'astro:content';
import { spanLabel } from '@/components/event/date-label';
import EventFacts from '@/components/event/EventFacts.astro';
import EventIllustration from '@/components/event/EventIllustration.astro';
import EventSummary from '@/components/event/EventSummary.astro';
import EventTags from '@/components/event/EventTags.astro';
import { Icon } from '@/components/ui/icon';
import type { Occurrence } from '@/core';
import type { EventDefinition } from '@/data/events';

interface Props {
  event: EventDefinition;
  entry: CollectionEntry<'events'>;
  dates: readonly Occurrence<EventDefinition>[];
  /** ビルドした日（YYYY-MM-DD）。次回の日付を選ぶのに使う */
  today: string;
  /** 表示範囲の年（例: 2026〜2027 年） */
  years: string;
}

const { event, entry, dates, today, years } = Astro.props;
// 次回の候補。ビルドした日にまだ終わっていない日付をすべて持たせ、表示時にブラウザの日付で選び直す（index.astro の script）
const remaining = dates.filter((o) => o.end >= today);
const next = remaining[0];
const candidates = JSON.stringify(
  remaining.map((o) => [o.start, o.end, spanLabel(o.start, o.end)]),
);
---

<li
  data-card
  class="group/card focus-ring-within relative flex flex-col rounded-xl border border-border-subtle bg-surface text-fg transition-[border-color,box-shadow] hover:border-saffron hover:shadow-2"
>
  <div class="overflow-hidden rounded-t-xl">
    <EventIllustration
      id={event.id}
      class="aspect-[16/7] transition-transform duration-(--8341-motion-duration-slow) group-hover/card:scale-[1.04]"
    />
  </div>
  <div class="flex flex-col gap-gap-sm p-inset-lg">
    <p class="m-0 text-label-sm tracking-wider text-fg-saffron">{event.name.romaji}</p>
    <h3 class="m-0 text-heading-xxs [font-feature-settings:'palt']">
      <a
        href={`/events/${event.id}/`}
        class="text-fg no-underline outline-none after:absolute after:inset-0 after:content-[''] group-hover/card:underline group-hover/card:underline-offset-[0.25em]"
      >
        {event.name.kana}
        <span class="text-body-sm font-regular text-fg-subtle">（{event.name.ja}）</span>
      </a>
    </h3>
    <EventTags event={event} />
  </div>
  <div
    data-popover
    class="mx-inset-lg mb-inset-lg flex flex-col gap-gap-md rounded-lg bg-subtle p-inset-md hoverable:pointer-events-none hoverable:absolute hoverable:inset-x-0 hoverable:top-full hoverable:z-10 hoverable:m-0 hoverable:mt-gap-xs hoverable:translate-y-1 hoverable:rounded-xl hoverable:border hoverable:border-border-subtle hoverable:bg-surface hoverable:p-inset-lg hoverable:opacity-0 hoverable:shadow-3 hoverable:transition-[opacity,translate] hoverable:group-focus-within/card:translate-y-0 hoverable:group-focus-within/card:opacity-100 hoverable:group-hover/card:translate-y-0 hoverable:group-hover/card:opacity-100"
  >
    <EventSummary entry={entry} />
    <div class="hidden flex-col gap-gap-sm rounded-lg bg-subtle p-inset-md hoverable:flex">
      <p class="m-0 text-label-sm text-fg-subtle">{years}の日付</p>
      <EventFacts event={event} dates={dates} tags={false} />
    </div>
  </div>
  <div
    data-next-dates={candidates}
    class="mt-auto flex items-center gap-gap-sm border-t border-border-subtle px-inset-lg py-inset-md"
  >
    <span class="text-label-sm text-fg-subtle">次回</span>
    <!-- 候補が尽きたら（表示期間の後）、日付の代わりにこの文言を出す。要素を増やさないよう time の中身を差し替える -->
    <time
      datetime={next?.start}
      data-next-none="次回の日付は、サイトの更新後に表示されます"
      class="text-body-sm font-bold"
    >
      {next ? spanLabel(next.start, next.end) : '次回の日付は、サイトの更新後に表示されます'}
    </time>
    <Icon
      name="arrow-right"
      size="sm"
      className="ms-auto text-icon-key transition-transform group-hover/card:translate-x-gap-xs"
    />
  </div>
</li>
