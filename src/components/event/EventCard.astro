---
// トップページの行事の一覧のカード。カード全体が詳細ページへのリンク。
// 由来と行うこと（data-details）は、スマホでも PC でもカードの中に出す。
// 以前は PC でだけホバーのポップアップにしていたが、スマホと同じ見せ方にそろえた（docs/improvement/log.md）
// 次回の日付は出さない。ビルドした日に依存し、年 1 回のビルドでは古くなるため（ADR-0015）
import type { CollectionEntry } from 'astro:content';
import EventIllustration from '@/components/event/EventIllustration.astro';
import EventSummary from '@/components/event/EventSummary.astro';
import EventTags from '@/components/event/EventTags.astro';
import { Icon } from '@/components/ui/icon';
import type { EventDefinition } from '@/data/events';

interface Props {
  event: EventDefinition;
  entry: CollectionEntry<'events'>;
}

const { event, entry } = Astro.props;
---

<li
  data-card
  class="group/card focus-ring-within relative flex flex-col rounded-sm border border-border-subtle bg-surface text-fg transition-[border-color,box-shadow] hover:border-saffron hover:shadow-2"
>
  <div class="overflow-hidden rounded-t-sm">
    <EventIllustration
      id={event.id}
      class="aspect-[16/7] transition-transform duration-(--8341-motion-duration-slow) group-hover/card:scale-[1.04]"
    />
  </div>
  <div class="flex flex-col gap-gap-sm p-inset-lg">
    <p class="m-0 text-label-sm tracking-wider text-fg-saffron">{event.name.romaji}</p>
    <h3 class="m-0 text-heading-xxs [font-feature-settings:'palt']">
      <a
        href={`/events/${event.id}/`}
        class="text-fg no-underline outline-none after:absolute after:inset-0 after:content-[''] group-hover/card:underline group-hover/card:underline-offset-[0.25em]"
      >
        {event.name.kana}
        <span class="text-body-sm font-regular text-fg-subtle">（{event.name.ja}）</span>
      </a>
    </h3>
    <EventTags event={event} />
  </div>
  <div
    data-details
    class="mx-inset-lg mb-inset-lg flex flex-col gap-gap-md rounded-xs bg-subtle p-inset-md"
  >
    <EventSummary entry={entry} />
  </div>
  <div class="mt-auto flex items-center gap-gap-sm border-t border-border-subtle px-inset-lg py-inset-md">
    <span class="text-label-sm text-fg-key">詳しく見る</span>
    <Icon
      name="arrow-right"
      size="sm"
      className="ms-auto text-icon-key transition-transform group-hover/card:translate-x-gap-xs"
    />
  </div>
</li>
