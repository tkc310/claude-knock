---
// トップページの月表示のカレンダー。表示範囲の全月を書き出し、前後の月はボタンで切り替える
// スマホ幅（md 未満）ではマスの中を色の点にし、その月の行事は表の下に文字で並べる（data-agenda）
import { dateLabel } from '@/components/event/date-label';
import { Icon } from '@/components/ui/icon';
import type { DateRange, Occurrence } from '@/core';
import type { EventDefinition } from '@/data/events';
import { calendarMonths, type CalendarItem } from '@/data/month-grid';

interface Props {
  range: DateRange;
  list: readonly Occurrence<EventDefinition>[];
  /** ビルドした日（YYYY-MM-DD）。最初に見せる月と「今日」の印に使う。表示時はブラウザの日付で置き換える */
  today: string;
}

const { range, list, today } = Astro.props;
const months = calendarMonths(range, list);
const key = (y: number, m: number) => `${y}-${String(m).padStart(2, '0')}`;
const initial = months.some((m) => key(m.year, m.month) === today.slice(0, 7))
  ? today.slice(0, 7)
  : key(months[0]!.year, months[0]!.month);
const initialTitle = `${initial.slice(0, 4)} 年 ${Number(initial.slice(5))} 月`;

const label = ({ event, mark }: CalendarItem) =>
  mark === 'start'
    ? `${event.name.kana} 始まり`
    : mark === 'end'
      ? `${event.name.kana} 終わり`
      : event.name.kana;

// 色分け: 仏教行事は僧衣のサフラン色、民間行事は水の青緑、ワンプラは月の金色。今日の印は藍（key）
type Tone = 'buddhist' | 'folk' | 'phra';
const tone = ({ event }: CalendarItem): Tone =>
  event.id === 'wan-phra' ? 'phra' : event.category === 'folk' ? 'folk' : 'buddhist';
const chip: Record<Tone, string> = {
  buddhist: 'border-saffron bg-saffron-subtle text-fg',
  folk: 'border-water bg-water-subtle text-fg',
  phra: 'border-gold text-fg-subtle',
};
const dot: Record<Tone, string> = {
  buddhist: 'bg-saffron',
  folk: 'bg-water',
  phra: 'bg-gold',
};
const weekdays = ['日', '月', '火', '水', '木', '金', '土'];
const dayTone = (date: string) => {
  const w = new Date(`${date}T00:00:00Z`).getUTCDay();
  return w === 0 ? 'text-fg-danger' : w === 6 ? 'text-fg-link' : '';
};
const navButton =
  'focus-ring tap-target inline-flex size-control-sm items-center justify-center rounded-full border border-border bg-surface text-icon hover:bg-muted disabled:cursor-not-allowed disabled:border-border-disabled disabled:text-fg-disabled disabled:hover:bg-surface';
const legend = [
  { label: '仏教行事', swatch: 'size-2.5 rounded-full bg-saffron' },
  { label: '民間行事', swatch: 'size-2.5 rounded-full bg-water' },
  { label: 'ワンプラ（布薩日）', swatch: 'size-2.5 rounded-full bg-gold' },
  { label: '今日', swatch: 'size-4 rounded-full bg-key ring-2 ring-gold-subtle' },
];
---

<div
  data-calendar
  data-initial={initial}
  class="flex flex-col gap-gap-md rounded-xl border border-border-subtle bg-surface p-inset-md md:p-inset-xl"
>
  <div class="flex items-center justify-between gap-gap-sm">
    <p data-cal-title aria-live="polite" class="m-0 text-heading-xs tabular-nums">
      {initialTitle}
    </p>
    <div class="flex items-center gap-gap-sm">
      <button
        type="button"
        data-cal-today
        class="focus-ring inline-flex h-control-sm items-center rounded-full border border-border bg-surface px-inset-md text-label-sm hover:bg-muted disabled:cursor-default disabled:border-border-disabled disabled:text-fg-disabled disabled:hover:bg-surface"
      >
        今月
      </button>
      <button type="button" data-cal-prev aria-label="前の月" class={navButton}>
        <Icon name="chevron-left" />
      </button>
      <button type="button" data-cal-next aria-label="次の月" class={navButton}>
        <Icon name="chevron-right" />
      </button>
    </div>
  </div>
  {months.map(({ year, month, weeks }) => (
    <table
      data-month={key(year, month)}
      data-title={`${year} 年 ${month} 月`}
      hidden={key(year, month) !== initial}
      class="w-full table-fixed border-collapse"
    >
      <caption class="sr-only">{`${year} 年 ${month} 月の行事`}</caption>
      <thead>
        <tr>
          {weekdays.map((w, i) => (
            <th
              scope="col"
              class:list={[
                'pb-inset-sm text-label-sm',
                i === 0 ? 'text-fg-danger' : i === 6 ? 'text-fg-link' : 'text-fg-subtle',
              ]}
            >
              {w}
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {weeks.map((week) => (
          <tr>
            {week.map((d) => (
              <td
                data-date={d.date}
                class="h-14 border-t border-border-subtle px-0.5 py-1 align-top aria-[current=date]:bg-gold-subtle md:h-24 md:p-inset-xs"
              >
                {d.inMonth && (
                  <div class="flex flex-col items-center gap-1 md:items-stretch">
                    <span
                      data-day
                      class:list={[
                        'inline-flex size-7 items-center justify-center self-center rounded-full text-dense-sm tabular-nums',
                        '[[aria-current=date]_&]:bg-key [[aria-current=date]_&]:font-bold [[aria-current=date]_&]:text-fg-on-key',
                        dayTone(d.date),
                      ]}
                    >
                      {Number(d.date.slice(8))}
                    </span>
                    {d.items.length > 0 && (
                      <>
                        <span
                          aria-hidden="true"
                          class="flex flex-wrap justify-center gap-0.5 md:hidden"
                        >
                          {d.items.map((item) => (
                            <span class:list={['size-2 rounded-full', dot[tone(item)]]} />
                          ))}
                        </span>
                        <ul class="m-0 hidden list-none flex-col gap-0.5 p-0 md:flex">
                          {d.items.map((item) => (
                            <li class="min-w-0">
                              <a
                                href={`/events/${item.event.id}/`}
                                title={label(item)}
                                class:list={[
                                  'focus-ring line-clamp-2 block rounded-xs border-s-2 px-1 py-px text-dense-sm no-underline hover:underline',
                                  chip[tone(item)],
                                ]}
                              >
                                {label(item)}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </>
                    )}
                  </div>
                )}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  ))}
  {months.map(({ year, month, weeks }) => {
    const days = weeks.flat().filter((d) => d.inMonth && d.items.length > 0);
    return (
      <div
        data-agenda={key(year, month)}
        hidden={key(year, month) !== initial}
        class="border-t border-border-subtle pt-inset-md md:hidden"
      >
        <p class="m-0 mb-gap-sm text-label-sm text-fg-subtle">{`${month} 月の行事`}</p>
        <ul class="m-0 flex list-none flex-col p-0">
          {days.flatMap((d) =>
            d.items.map((item) => (
              <li class="flex items-center gap-gap-sm border-b border-border-subtle py-inset-sm last:border-b-0">
                <time
                  datetime={d.date}
                  class:list={[
                    'w-32 shrink-0 text-body-sm whitespace-nowrap tabular-nums',
                    dayTone(d.date),
                  ]}
                >
                  {dateLabel(d.date, { year: false })}
                </time>
                <span
                  aria-hidden="true"
                  class:list={['size-2 shrink-0 rounded-full', dot[tone(item)]]}
                />
                <a
                  href={`/events/${item.event.id}/`}
                  class="focus-ring rounded-xs text-body-sm text-fg-link underline underline-offset-[0.2em]"
                >
                  {label(item)}
                </a>
              </li>
            )),
          )}
        </ul>
      </div>
    );
  })}
  <ul
    data-legend
    class="m-0 flex list-none flex-wrap gap-x-gap-md gap-y-gap-xs border-t border-border-subtle p-0 pt-inset-md"
  >
    {legend.map(({ label, swatch }) => (
      <li class="flex items-center gap-gap-xs text-body-sm text-fg-subtle">
        <span aria-hidden="true" class:list={['shrink-0', swatch]} />
        {label}
      </li>
    ))}
  </ul>
</div>

<script>
  // 前後の月の切り替えと、ブラウザの日付での「今日」の印
  for (const root of document.querySelectorAll<HTMLElement>('[data-calendar]')) {
    const tables = [...root.querySelectorAll<HTMLTableElement>('table[data-month]')];
    const agendas = [...root.querySelectorAll<HTMLElement>('[data-agenda]')];
    const title = root.querySelector<HTMLElement>('[data-cal-title]')!;
    const prev = root.querySelector<HTMLButtonElement>('[data-cal-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-cal-next]')!;
    const current = root.querySelector<HTMLButtonElement>('[data-cal-today]')!;
    const today = new Date().toLocaleDateString('sv-SE');
    const start = tables.findIndex((t) => t.dataset.month === today.slice(0, 7));
    const home =
      start >= 0 ? start : tables.findIndex((t) => t.dataset.month === root.dataset.initial);
    let index = home;

    const show = () => {
      tables.forEach((t, i) => (t.hidden = i !== index));
      agendas.forEach((a, i) => (a.hidden = i !== index));
      title.textContent = tables[index]!.dataset.title ?? '';
      prev.disabled = index === 0;
      next.disabled = index === tables.length - 1;
      current.disabled = index === home;
    };
    prev.addEventListener('click', () => {
      index = Math.max(0, index - 1);
      show();
    });
    next.addEventListener('click', () => {
      index = Math.min(tables.length - 1, index + 1);
      show();
    });
    current.addEventListener('click', () => {
      index = home;
      show();
    });

    // 前後の月の枠埋めのマスにも同じ日付があるので、その月の日（日付の数字があるマス）だけに付ける
    root
      .querySelector(`td[data-date="${today}"]:has([data-day])`)
      ?.setAttribute('aria-current', 'date');
    show();
  }
</script>
