---
// 行事のイメージイラスト（自作の SVG）。行事の中身を連想させるモチーフを 1 つ描く。
// 飾りなので読み上げない（行事名は見出しにある）。
// 同じ色の繰り返しの図形（灯明・雨・輻など）は 1 つの path にまとめ、ページの DOM を小さくする（ADR-0013）
import type { EventId } from '@/data/events';

interface Props {
  id: EventId;
  class?: string;
}

const { id, class: className } = Astro.props;

// 法輪の 8 本の輻（スポーク）と先端の飾り
const spokes = Array.from({ length: 8 }, (_, i) => {
  const a = (i * Math.PI) / 4;
  return {
    x: 160 + Math.cos(a) * 52,
    y: 70 + Math.sin(a) * 52,
    kx: 160 + Math.cos(a) * 62,
    ky: 70 + Math.sin(a) * 62,
  };
});
// ウェンティエンの灯明。仏塔を楕円に囲む
const candles = Array.from({ length: 14 }, (_, i) => {
  const a = (i * 2 * Math.PI) / 14;
  return { x: 160 + Math.cos(a) * 110, y: 112 + Math.sin(a) * 18 };
});
const rain = [30, 70, 110, 210, 250, 290, 50, 90, 230, 270];
const monks = [104, 160, 216];

// 円・楕円を path の部分路にする（いくつも並べて 1 つの path にするため）
const ellipse = (cx: number, cy: number, rx: number, ry = rx) =>
  `M${cx - rx} ${cy}a${rx} ${ry} 0 1 0 ${2 * rx} 0a${rx} ${ry} 0 1 0 ${-2 * rx} 0Z`;
function paths<T>(items: readonly T[], f: (item: T) => string): string {
  return items.map(f).join('');
}
---

<svg
  viewBox="0 0 320 140"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
  data-illustration={id}
  class:list={['block w-full', className]}
>
  {id === 'wan-phra' && (
    <>
      <rect width="320" height="140" fill="#2E3A6B" />
      <path d={ellipse(40, 24, 1.5) + ellipse(282, 30, 1.5) + ellipse(160, 18, 1.2)} fill="#fff" />
      <path d={paths([70, 130, 190, 250], (x) => ellipse(x, 74, 22))} fill="#46528A" />
      <path d="M70 52 A22 22 0 0 1 70 96 Z" fill="#F6E7B0" />
      <circle cx="130" cy="74" r="22" fill="#F6E7B0" />
      <path d="M190 52 A22 22 0 0 0 190 96 Z" fill="#F6E7B0" />
      <circle
        cx="250"
        cy="74"
        r="21"
        fill="none"
        stroke="#F6E7B0"
        stroke-width="2"
        stroke-dasharray="3 4"
      />
    </>
  )}
  {id === 'makha-bucha' && (
    <>
      <rect width="320" height="140" fill="#3B3F70" />
      <path d="M128 112 h64 v-10 h-64 Z" fill="#E8B04B" />
      <path d="M134 102 C134 70 186 70 186 102 Z" fill="#F2C14E" />
      <rect x="152" y="58" width="16" height="10" fill="#E8B04B" />
      <path d="M160 18 L168 58 H152 Z" fill="#F2C14E" />
      <path d={paths(candles, ({ x, y }) => `M${x - 2} ${y - 8}h4v10h-4Z`)} fill="#FFF6E5" />
      <path d={paths(candles, ({ x, y }) => ellipse(x, y - 12, 3, 5))} fill="#FFB547" />
    </>
  )}
  {id === 'visakha-bucha' && (
    <>
      <rect width="320" height="140" fill="#EAF4E4" />
      <circle cx="236" cy="40" r="22" fill="#F6E7B0" />
      <path
        d="M160 128 C120 100 104 64 120 38 C134 18 156 26 160 40 C164 26 186 18 200 38 C216 64 200 100 160 128 Z"
        fill="#5E9C5A"
      />
      <path
        d="M160 40 V122 M160 64 L136 50 M160 64 L184 50 M160 86 L132 72 M160 86 L188 72 M160 106 L142 96 M160 106 L178 96"
        stroke="#CFE6C4"
        stroke-width="2"
        fill="none"
      />
      <path d="M160 128 V136" stroke="#5E9C5A" stroke-width="3" />
    </>
  )}
  {id === 'atthami-bucha' && (
    <>
      <rect width="320" height="140" fill="#F7EBDD" />
      <path
        d="M160 26 C178 48 192 62 184 88 C178 104 142 104 136 88 C128 62 146 52 160 26 Z"
        fill="#E8743B"
      />
      <path
        d="M160 54 C170 66 176 76 172 90 C168 98 152 98 148 90 C144 76 152 68 160 54 Z"
        fill="#F7C14E"
      />
      <rect x="110" y="98" width="100" height="10" rx="3" fill="#8A5A36" />
      <rect x="120" y="108" width="80" height="10" rx="3" fill="#6E4628" />
      <rect x="104" y="118" width="112" height="10" rx="3" fill="#8A5A36" />
    </>
  )}
  {id === 'asarnha-bucha' && (
    <>
      <rect width="320" height="140" fill="#FFF3D6" />
      <circle cx="160" cy="70" r="52" fill="none" stroke="#D99A2B" stroke-width="6" />
      <path
        d={paths(spokes, ({ x, y }) => `M160 70L${x} ${y}`)}
        stroke="#D99A2B"
        stroke-width="4"
      />
      <path d={paths(spokes, ({ kx, ky }) => ellipse(kx, ky, 5))} fill="#D99A2B" />
      <circle cx="160" cy="70" r="12" fill="#D99A2B" />
      <circle cx="160" cy="70" r="5" fill="#FFF3D6" />
    </>
  )}
  {id === 'khao-phansa' && (
    <>
      <rect width="320" height="140" fill="#DCEBFA" />
      <path
        d={rain.map((x, i) => `M${x} ${i < 6 ? 20 : 70}l-6 20`).join('')}
        stroke="#7FB3D5"
        stroke-width="3"
        stroke-linecap="round"
      />
      <rect x="140" y="44" width="40" height="80" rx="4" fill="#F2C14E" />
      <path d="M140 70 h40 M140 96 h40" stroke="#D99A2B" stroke-width="4" />
      <rect x="130" y="122" width="60" height="8" rx="2" fill="#B07A3B" />
      <line x1="160" y1="44" x2="160" y2="36" stroke="#5B3A1E" stroke-width="2" />
      <path d="M160 14 C168 24 168 32 160 36 C152 32 152 24 160 14 Z" fill="#FF9F2E" />
    </>
  )}
  {id === 'ok-phansa' && (
    <>
      <rect width="320" height="140" fill="#F4E6CF" />
      <circle cx="160" cy="44" r="26" fill="#FFF8E1" />
      <path d={paths(monks, (x) => ellipse(x, 86, 9))} fill="#C98E62" />
      <path
        d={paths(monks, (x) => `M${x - 24} 128 C${x - 22} 100 ${x + 22} 100 ${x + 24} 128 Z`)}
        fill="#E07B2B"
      />
      <path
        d={paths(monks, (x) => `M${x - 6} 102 L${x + 18} 128`)}
        stroke="#B85E1B"
        stroke-width="3"
      />
    </>
  )}
  {id === 'thot-kathin' && (
    <>
      <rect width="320" height="140" fill="#FFF1E0" />
      <path d="M96 120 h128 l-12 12 h-104 Z" fill="#B07A3B" />
      <rect x="112" y="96" width="96" height="22" rx="4" fill="#C9661C" />
      <rect x="118" y="74" width="84" height="22" rx="4" fill="#E07B2B" />
      <rect x="124" y="52" width="72" height="22" rx="4" fill="#F09A3E" />
      <path
        d="M124 63 h72 M118 85 h84 M112 107 h96"
        stroke="#FFF1E0"
        stroke-width="1.5"
        stroke-dasharray="4 4"
      />
    </>
  )}
  {id === 'loi-krathong' && (
    <>
      <rect width="320" height="140" fill="#1F2A55" />
      <circle cx="250" cy="34" r="18" fill="#F6E7B0" />
      <rect y="96" width="320" height="44" fill="#2D4A7A" />
      <path
        d="M0 104 q20 -6 40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0"
        stroke="#7FB3D5"
        stroke-width="2"
        fill="none"
      />
      <path
        d="M0 122 q20 -6 40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0"
        stroke="#7FB3D5"
        stroke-width="2"
        fill="none"
        opacity="0.6"
      />
      <ellipse cx="150" cy="100" rx="46" ry="10" fill="#4E8A4A" />
      <path
        d={paths([118, 134, 150, 166, 182], (x) => `M${x - 10} 98 L${x} 74 L${x + 10} 98 Z`)}
        fill="#6BAF5F"
      />
      <circle cx="140" cy="80" r="5" fill="#F28CB1" />
      <circle cx="162" cy="78" r="5" fill="#F6E7B0" />
      <rect x="149" y="60" width="4" height="18" fill="#FFF6E5" />
      <path d="M151 46 C157 54 157 58 151 60 C145 58 145 54 151 46 Z" fill="#FFB547" />
    </>
  )}
  {id === 'songkran' && (
    <>
      <rect width="320" height="140" fill="#E3F4FA" />
      <path d="M110 76 h100 C206 112 186 124 160 124 C134 124 114 112 110 76 Z" fill="#C9A24B" />
      <ellipse cx="160" cy="76" rx="50" ry="8" fill="#5FA8D3" />
      <path
        d={paths(
          [
            [140, 52, 4],
            [160, 40, 5],
            [182, 50, 4],
            [124, 34, 3],
            [198, 30, 3],
            [170, 20, 3],
          ] as const,
          ([x, y, r]) =>
            `M${x} ${y - r * 2} C${x + r} ${y - r / 2} ${x + r} ${y + r} ${x} ${y + r} C${x - r} ${y + r} ${x - r} ${y - r / 2} ${x} ${y - r * 2} Z`,
        )}
        fill="#5FA8D3"
      />
      <path d={paths([146, 160, 174], (x) => ellipse(x, 74, 4))} fill="#FFFFFF" />
    </>
  )}
</svg>
