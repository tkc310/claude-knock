---
// トップページの冒頭の「次の行事」の 1 件（data-next-event）。イラスト・行事名・日付と、あと何日か（data-countdown。index.astro の script が書く）
import { spanLabel } from '@/components/event/date-label';
import EventIllustration from '@/components/event/EventIllustration.astro';
import type { Occurrence } from '@/core';
import type { EventDefinition } from '@/data/events';

interface Props {
  occurrence: Occurrence<EventDefinition>;
}

const { occurrence } = Astro.props;
const { event } = occurrence;
---

<a
  data-next-event
  data-start={occurrence.start}
  data-end={occurrence.end}
  href={`/events/${event.id}/`}
  class="group/next focus-ring flex flex-col text-fg no-underline"
>
  <span class="mx-inset-lg block overflow-hidden rounded-xs">
    <EventIllustration
      id={event.id}
      class="aspect-[16/7] transition-transform duration-(--8341-motion-duration-slow) group-hover/next:scale-[1.04]"
    />
  </span>
  <span class="flex flex-col gap-gap-xs px-inset-lg pt-inset-md pb-inset-lg">
    <span class="flex items-baseline justify-between gap-gap-sm">
      <span class="text-heading-xxs group-hover/next:underline group-hover/next:underline-offset-[0.25em]">
        {event.name.kana}
      </span>
      <span
        data-countdown
        class="shrink-0 rounded-xs bg-saffron-subtle px-inset-sm py-0.5 text-label-sm text-fg-saffron empty:hidden"
      />
    </span>
    <span class="text-body-sm text-fg-subtle">{event.name.ja}</span>
    <time datetime={occurrence.start} class="text-body-sm font-bold">
      {spanLabel(occurrence.start, occurrence.end)}
    </time>
  </span>
</a>
