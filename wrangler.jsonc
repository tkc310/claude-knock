// Cloudflare Workers の静的アセットで dist/ をそのまま配る（ADR-0016）。
// Worker のスクリプト（main）と Astro のアダプターは使わない。デプロイは make deploy か、
// main の CI が通った後の .github/workflows/deploy.yml
{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "koyomi",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./dist"
  },
  // 独自ドメイン。tkc310.com のゾーンが同じ Cloudflare アカウントにある前提で、DNS と証明書も wrangler が用意する
  "routes": [{ "pattern": "koyomi.tkc310.com", "custom_domain": true }]
}
